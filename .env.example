# PayPal Sandbox. Rotate any credential that was pasted into chat, then add the
# replacements to .env.local (never commit that file).
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_CURRENCY=USD
# Optional override; normally leave unset.
PAYPAL_API_BASE=

# Amazon Bedrock document analysis.
DOCUMENT_ANALYSIS_MODE=demo
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
BEDROCK_MODEL_ID=

